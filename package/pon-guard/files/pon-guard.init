#!/bin/sh /etc/rc.common
# Licensed to the public under the Apache License 2.0.
#
# Runs before pon.init (S18). See the package Makefile for the full story.

START=17

boot() {
	guard
}

start() {
	guard
}

guard() {
	local mode
	mode="$(uci -q get pon.line0.mode)"

	case "$mode" in
		epon-1g|epon1g|epon_1g)
			logger -t pon-guard \
				"stored mode '$mode' blocks PON probe on AN758x; forcing epon-10g-1g"
			uci set pon.line0.mode='epon-10g-1g'
			uci commit pon
			;;
		'')
			# A fresh flash has no mode stored and pon.init then falls back to
			# xgpon, which never registers on this EPON line. Default to the
			# mode that is known to work here.
			logger -t pon-guard \
				"no PON mode stored; defaulting to epon-10g-1g"
			uci set pon.line0.mode='epon-10g-1g'
			uci commit pon
			;;
	esac
}
