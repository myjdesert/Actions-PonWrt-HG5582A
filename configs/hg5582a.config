# Extra Kconfig fragment merged on top of the upstream PonWrt an7581 config.
# Keeps the build focused on the FiberHome HG5382A / HG5582A (Airoha AN7581DT)
# and pulls in the PON management pages.

# Device selection (HG5582A shares the hg5382a device profile; the only
# difference is the telephone port, which needs a vendor SLIC driver that is
# not available in mainline).
CONFIG_TARGET_airoha_an7581_DEVICE_fiberhome_hg5382a=y

# PON userspace / driver packages are already part of DEVICE_PACKAGES of
# fiberhome_hg5382a, listed here so the build fails loudly if upstream drops
# them from the device profile.
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y

# LuCI: PON line-mode page and the IPTV VLAN page.
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-app-iptv=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Remote shell, handy when the web UI is unreachable.
CONFIG_PACKAGE_ttyd=y

# UPnP must stay off. Upstream release.config enables luci-app-upnp, which pulls
# in miniupnpd, and miniupnpd currently fails to build: its feed patch
# 020-descr-filter-fix.patch no longer applies to miniupnpd-2.3.11. The feature
# is pointless on a PON ONU used as an IPTV bridge, so disable the whole chain.
# These lines are appended last, so they override release.config.
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set
