# ---------------------------------------------------------------
# Nokia XG-040G-MF extra features, merged on top of configs/an7583.config
# ---------------------------------------------------------------
# Every line here is applied *after* the upstream PonWrt profile, so this
# file is the only place where the extras are decided.
#
# NOTE: unknown symbol names are dropped silently by `make defconfig`, which
# is why the workflow re-checks the resulting .config and the built manifest.
# ---------------------------------------------------------------

# ---------- USB ----------
# The board has an xhci-mtk controller (usb@1fab0000) fed by
# regulator-usb-5v, i.e. a real USB3 port. These are the pieces needed for
# a stick to appear as /dev/sda and mount on its own.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_usbutils=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y

# USB Ethernet adapters. rtl8152 covers the RTL8156 2.5G dongles, which is
# the cheap way to get a 2.5G peer for LAN1 testing.
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# ---------- EasyTier ----------
# easytier itself is not compiled here: its Makefile downloads the prebuilt
# aarch64 release from the upstream project.
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# ---------- OpenClash ----------
# dnsmasq-full and kmod-tun are already enabled by the an7583 profile.
# luci-compat is required: OpenClash is a Lua/CBI app and current LuCI is JS.
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-openclash=y
