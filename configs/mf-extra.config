# ---------------------------------------------------------------
# Nokia XG-040G-MF extra features, merged on top of configs/an7583.config
# ---------------------------------------------------------------
# Every line here is applied *after* the upstream PonWrt profile, so this
# file is the only place where the extras are decided.
#
# NOTE: unknown symbol names are dropped silently by `make defconfig`, which
# is why the workflow re-checks the resulting .config and the built manifest.
# ---------------------------------------------------------------

# ---------- USB ----------
# The board has an xhci-mtk controller (usb@1fab0000) fed by
# regulator-usb-5v, i.e. a real USB3 port. These are the pieces needed for
# a stick to appear as /dev/sda and mount on its own.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_usbutils=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y

# USB Ethernet adapters. rtl8152 covers the RTL8156 2.5G dongles, which is
# the cheap way to get a 2.5G peer for LAN1 testing.
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# ---------- EasyTier ----------
# easytier itself is not compiled here: its Makefile downloads the prebuilt
# aarch64 release from the upstream project.
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y

# ---------- OpenClash ----------
# dnsmasq-full and kmod-tun are already enabled by the an7583 profile.
# luci-compat is required: OpenClash is a Lua/CBI app and current LuCI is JS.
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-openclash=y

# Web terminal, so the box stays reachable when sshd or the network is broken.
CONFIG_PACKAGE_ttyd=y

# ---------- IPTV bridge ----------
# Local package (package/luci-app-iptv). Carries the two fixes that were found
# the hard way on this line:
#   * service VLAN (45) and multicast VLAN (50) are separate settings, so the
#     PPPoE session cannot end up pushed into the multicast VLAN;
#   * with both VLANs set the bridge runs vlan_filtering=1, the service VLAN
#     leaves the LAN port untagged and the multicast VLAN tagged.
CONFIG_PACKAGE_luci-app-iptv=y

# ---------- SoC status ----------
# Local package (package/luci-app-socinfo). The board exposes cpu-thermal,
# gbe-thermal and cpu-die-thermal; the page also shows per-core clock,
# governor, load, memory and attached storage.
CONFIG_PACKAGE_luci-app-socinfo=y

# ---------- PON boot guard ----------
# Local package (package/pon-guard). epon-1g blocks the EN7572 probe before
# network starts, so the box would boot with no IP at all; this rewrites a
# stored epon-1g back to epon-10g-1g at S17.
CONFIG_PACKAGE_pon-guard=y

# ---------- rtp2httpd ----------
# Local packages derived from stackia/rtp2httpd. The main package pins
# v3.17.2 and its source hash, so the build does not need a checkout.
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y

# ---------- USB automount ----------
# Local package (package/usb-automount). Mounts a stick under /mnt/<dev> as soon
# as it is plugged in, and luci-app-socinfo lists it. Not using the tree's
# `automount` package: it wants kmod-fs-ntfs, which is not built for 6.18.
CONFIG_PACKAGE_usb-automount=y

# ---------- UPnP must stay off ----------
# Upstream configs/release.config enables luci-app-upnp, which pulls in
# miniupnpd. miniupnpd currently fails to build: its feed patch
# 020-descr-filter-fix.patch no longer applies to miniupnpd-2.3.11. This block
# is appended last, so it overrides release.config.
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_miniupnpd-nftables is not set
# CONFIG_PACKAGE_miniupnpd-iptables is not set
